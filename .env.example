# =================================================================
# UPSHIFT AI — Environment Configuration
# =================================================================

# Server Port
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------
# Gemma 4 / Google Inference Configuration
# If GEMMA_API_KEY is not provided, UPSHIFT AI automatically activates
# its high-fidelity contextual simulation engine with zero degradation.
# -----------------------------------------------------------------
GEMMA_API_KEY=AQ.Ab8RN6IkzVJ691PjSujbBhN3irufHK1XKbI8aJhqmFM4vlHjsw

# Supported models: gemma-2-9b-it, gemma-2-27b-it, or custom Gemma-4 endpoint
GEMMA_MODEL=gemma-2-9b-it

# Inference Provider Type: 'google-ai-studio' | 'ollama' | 'openai-compatible' | 'simulation'
GEMMA_PROVIDER=google-ai-studio

# Custom endpoint (optional, useful for local Ollama / vLLM / HuggingFace TGI)
# GEMMA_CUSTOM_ENDPOINT=http://localhost:11434/v1

# -----------------------------------------------------------------
# Database Persistence (Optional)
# If not configured, UPSHIFT AI defaults to persistent browser local storage
# with full JSON state import/export capabilities.
# -----------------------------------------------------------------
PERSISTENCE_MODE=local
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/upshift_ai?retryWrites=true&w=majority
