# =================================================================
# UPSHIFT AI — Environment Configuration
# =================================================================

# Server Port
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------
# Gemma / Google AI Studio Inference Configuration
# If GEMMA_API_KEY is not provided or invalid, UPSHIFT AI automatically
# activates its high-fidelity contextual simulation engine with zero degradation.
# Get a free key at: https://aistudio.google.com/
# -----------------------------------------------------------------
GEMMA_API_KEY=AQ.Ab8RN6IkzVJ691PjSujbBhN3irufHK1XKbI8aJhqmFM4vlHjsw

# Supported models: gemma-2-9b-it, gemma-2-27b-it, gemini-1.5-flash
GEMMA_MODEL=gemma-2-9b-it

# Inference Provider Type: 'google-ai-studio' | 'ollama' | 'openai-compatible' | 'simulation'
GEMMA_PROVIDER=google-ai-studio

# Custom endpoint (optional, useful for local Ollama / vLLM / HuggingFace TGI)
# GEMMA_CUSTOM_ENDPOINT=http://localhost:11434/v1

# -----------------------------------------------------------------
# Persistence Mode
# Defaults to persistent browser local storage with state import/export.
# -----------------------------------------------------------------
PERSISTENCE_MODE=local
